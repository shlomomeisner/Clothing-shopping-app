# Password for /admin, where you post items.
ADMIN_PASSWORD=

# Affiliate IDs. Without them, links go straight to the store and earn nothing.
SKIMLINKS_ID=
AMAZON_TAG=

# Database (set automatically when you add Upstash Redis in Vercel → Storage).
# Leave empty locally; posts save to data/db.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
