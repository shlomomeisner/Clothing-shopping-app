# Affiliate IDs. Without them, buy links go straight to the store and earn nothing.
SKIMLINKS_ID=
AMAZON_TAG=

# Your owner password, for removing any post and reading reports (x-admin-password header).
ADMIN_PASSWORD=

# Database (set automatically when you add Upstash Redis in Vercel → Storage).
# Leave empty locally; everything saves to data/kv.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
